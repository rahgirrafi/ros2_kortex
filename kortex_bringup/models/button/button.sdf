<?xml version="1.0"?>
<sdf version="1.7">
  <model name="push_button">
    <static>false</static>
    <pose>0 0 0 0 0 0</pose>

    <!-- Base plate with mesh -->
    <link name="base">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.001</ixx>
          <iyy>0.001</iyy>
          <izz>0.001</izz>
        </inertia>
      </inertial>
      
      <collision name="base_collision">
        <geometry>
          <mesh>
            <uri>meshes/button.dae</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.8</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>1000000.0</kp>
              <kd>100.0</kd>
            </ode>
          </contact>
        </surface>
      </collision>
      
      <visual name="base_visual">
        <geometry>
          <mesh>
            <uri>meshes/button.dae</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
        </material>
      </visual>
    </link>

  </model>
</sdf>